{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/heritage-short/storyboard.schema.json",
  "title": "Heritage Short Storyboard",
  "description": "Single-source-of-truth contract between all pipeline stages.",
  "type": "object",
  "required": [
    "title",
    "language",
    "target_duration_sec",
    "aspect_ratios",
    "style_block",
    "character_ref",
    "music",
    "shots"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "description": "Narration language (e.g., Amharic, Afaan Oromo, Tigrinya, Somali, English)."
    },
    "target_duration_sec": {
      "type": "number",
      "minimum": 60,
      "maximum": 90
    },
    "aspect_ratios": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "allOf": [
        { "contains": { "const": "9:16" } },
        { "contains": { "const": "16:9" } }
      ],
      "items": {
        "type": "string",
        "enum": ["9:16", "16:9"]
      }
    },
    "style_block": {
      "type": "string",
      "minLength": 10,
      "description": "Fixed visual look (lighting, palette, lens feel, texture) prepended/appended to every keyframe prompt."
    },
    "character_ref": {
      "type": "object",
      "required": ["id", "prompt", "seed", "image_path"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 10 },
        "seed": { "type": "integer", "minimum": 0 },
        "image_path": { "type": "string", "minLength": 1 }
      }
    },
    "music": {
      "type": "object",
      "required": ["model", "caption", "bpm", "key", "instrumental", "seed", "chosen_track"],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "enum": ["ace-step-1.5", "lyria-3.5", "musicgen-small"]
        },
        "caption": { "type": "string", "minLength": 5 },
        "bpm": { "type": "integer", "minimum": 40, "maximum": 200 },
        "key": { "type": "string", "minLength": 1 },
        "instrumental": { "type": "boolean" },
        "seed": { "type": "integer", "minimum": 0 },
        "chosen_track": { "type": "string" }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration_sec",
          "shot_reason",
          "shot_size",
          "visual_prompt",
          "camera_motion",
          "narration_text",
          "subtitle_en",
          "music_cue",
          "seed",
          "video_model",
          "draft_resolution",
          "consent_verified",
          "cache_key"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^shot_[0-9]{2}$"
          },
          "duration_sec": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 20
          },
          "shot_reason": {
            "type": "string",
            "minLength": 5,
            "description": "Explicit reason why this shot exists in the film."
          },
          "shot_size": {
            "type": "string",
            "enum": [
              "extreme_wide",
              "wide",
              "medium",
              "medium_close_up",
              "close_up",
              "extreme_close_up",
              "insert"
            ]
          },
          "visual_prompt": {
            "type": "string",
            "minLength": 10
          },
          "camera_motion": {
            "type": "string",
            "minLength": 3
          },
          "narration_text": {
            "type": "string"
          },
          "subtitle_en": {
            "type": "string"
          },
          "music_cue": {
            "type": "string",
            "minLength": 3,
            "description": "Spotting note / emotional role of music during this shot."
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "video_model": {
            "type": "string",
            "enum": ["wan-2.2", "hunyuan-video-1.5", "gemini-omni-flash", "ken-burns"]
          },
          "draft_resolution": {
            "type": "string",
            "enum": ["480p", "720p"]
          },
          "consent_verified": {
            "type": "boolean"
          },
          "cache_key": {
            "type": "string"
          }
        }
      }
    }
  }
}
