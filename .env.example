# Copy this file to `.env` and fill in your own keys.
# NEVER commit `.env` or real API keys to git.

# Google AI Studio (Gemini 3.8 Flash, Flash-Lite, Gemini 3.8 Flash TTS)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Workers AI (FLUX.2 klein / FLUX.1 schnell)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Kaggle (Wan 2.2 TI2V-5B / HunyuanVideo 1.5 / ACE-Step 1.5 on 2x T4)
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_key_here

# Optional: Hugging Face (if hosting a static page or Gradio Space showcase)
HF_TOKEN=

# Optional: Cohort Frontier Key (only if provided by cohort for comparison)
FRONTIER_API_KEY=
